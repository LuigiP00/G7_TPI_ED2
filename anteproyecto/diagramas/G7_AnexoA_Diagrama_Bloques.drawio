ura LM35&lt;br&gt;10 mV/°C" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="220" height="60" as="geometry"/></mxCell><mxCell id="ppg" value="&lt;b&gt;SSE.6.2&lt;/b&gt;&lt;br&gt;Sensor de pulso óptico (PPG)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="220" height="55" as="geometry"/></mxCell><mxCell id="acond" value="&lt;b&gt;SSE.6.3&lt;/b&gt;&lt;br&gt;Acondicionamiento&lt;br&gt;divisor 1/2 o LM358 + filtros" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="220" height="60" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;SSE.1.1&lt;/b&gt;&lt;br&gt;Alimentación +5 V&lt;br&gt;(USB vía CP2102)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="220" height="70" as="geometry"/></mxCell><mxCell id="vref" value="&lt;b&gt;SSE.1.2&lt;/b&gt;&lt;br&gt;Referencia Vref+ = 2,56 V&lt;br&gt;trimmer 10 kΩ + 100 nF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="220" height="80" as="geometry"/></mxCell><mxCell id="mcu" value="&lt;b&gt;SSEP.2.1&lt;/b&gt;&lt;br&gt;Microcontrolador PIC16F887&lt;br&gt;Cristal 4 MHz + reset MCLR&lt;br&gt;&lt;br&gt;ADC (AN0, AN1, VREF+)&lt;br&gt;Timer0: base 10 ms (muestreo)&lt;br&gt;Timer1: base 5 ms (displays)&lt;br&gt;EUSART 9600 bps 8N1&lt;br&gt;RX: teclas desde la GUI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x